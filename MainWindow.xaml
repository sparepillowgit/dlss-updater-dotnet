<Window x:Class="dlss_updater.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DLSS Updater"
        Icon="Assets/dlss-updater.ico"
        Width="750"
        MinWidth="700"
        SizeToContent="Height"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="#F3F3F3"
        FontFamily="Segoe UI">

    <Window.Resources>

        

        <Style x:Key="Card"
               TargetType="Border">

            <Setter Property="Background"
                    Value="#FFFFFF"/>

            <Setter Property="BorderBrush"
                    Value="#E5E5E5"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="CornerRadius"
                    Value="6"/>

        </Style>


        

        <Style x:Key="SectionTitle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="15"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="#1A1A1A"/>

            <Setter Property="VerticalAlignment"
                    Value="Center"/>

        </Style>


        

        <Style TargetType="TextBlock">

            <Setter Property="FontFamily"
                    Value="Segoe UI"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="Foreground"
                    Value="#1A1A1A"/>

        </Style>


        

        <Style TargetType="Button">

            <Setter Property="Height"
                    Value="37"/>

            <Setter Property="MinWidth"
                    Value="90"/>

            <Setter Property="Padding"
                    Value="16,0"/>

            <Setter Property="FontFamily"
                    Value="Segoe UI"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="Foreground"
                    Value="#1A1A1A"/>

            <Setter Property="Background"
                    Value="#FFFFFF"/>

            <Setter Property="BorderBrush"
                    Value="#D6D6D6"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">

                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Margin="{TemplateBinding Padding}"
                                RecognizesAccessKey="True"/>

                        </Border>


                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#F5F5F5"/>

                            </Trigger>


                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#EDEDED"/>

                            </Trigger>


                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.5"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        

        <Style x:Key="ExpandButton"
               TargetType="Button">

            <Setter Property="Width"
                    Value="28"/>

            <Setter Property="Height"
                    Value="28"/>

            <Setter Property="Padding"
                    Value="0"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Foreground"
                    Value="#666666"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ExpandButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>


                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ExpandButtonBorder"
                                        Property="Background"
                                        Value="#F0F0F0"/>

                            </Trigger>


                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ExpandButtonBorder"
                                        Property="Background"
                                        Value="#E5E5E5"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <Style x:Key="ScrollBarThumb"
               TargetType="Thumb">

            <Setter Property="Background"
                    Value="#C8C8C8"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Thumb">

                        <Border x:Name="ThumbBorder"
                                Width="6"
                                HorizontalAlignment="Center"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3"/>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ThumbBorder"
                                        Property="Background"
                                        Value="#A8A8A8"/>

                            </Trigger>

                            <Trigger Property="IsDragging"
                                     Value="True">

                                <Setter TargetName="ThumbBorder"
                                        Property="Background"
                                        Value="#909090"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        

        <Style TargetType="ScrollBar">

            <Setter Property="Width"
                    Value="8"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="ScrollBar">

                        <Grid Background="Transparent">

                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True">

                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  IsTabStop="False"
                                                  Opacity="0"/>
                                </Track.DecreaseRepeatButton>

                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollBarThumb}"/>
                                </Track.Thumb>

                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  IsTabStop="False"
                                                  Opacity="0"/>
                                </Track.IncreaseRepeatButton>

                            </Track>

                        </Grid>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>


        

        <Style x:Key="PrimaryButton"
               TargetType="Button">

            <Setter Property="Height"
                    Value="37"/>

            <Setter Property="MinWidth"
                    Value="110"/>

            <Setter Property="Padding"
                    Value="16,0"/>

            <Setter Property="FontFamily"
                    Value="Segoe UI"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="Foreground"
                    Value="#FFFFFF"/>

            <Setter Property="Background"
                    Value="#0067C0"/>

            <Setter Property="BorderBrush"
                    Value="#0067C0"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">

                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Margin="{TemplateBinding Padding}"
                                RecognizesAccessKey="True"/>

                        </Border>


                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#1976D2"/>

                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="#1976D2"/>

                            </Trigger>


                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#005A9E"/>

                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="#005A9E"/>

                            </Trigger>


                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.5"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        

        <Style TargetType="TextBox">

            <Setter Property="Height"
                    Value="37"/>

            <Setter Property="Padding"
                    Value="10,0"/>

            <Setter Property="FontFamily"
                    Value="Segoe UI"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="Foreground"
                    Value="#1A1A1A"/>

            <Setter Property="Background"
                    Value="#FFFFFF"/>

            <Setter Property="BorderBrush"
                    Value="#D6D6D6"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="TextBox">

                        <Border x:Name="TextBoxBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">

                            <ScrollViewer x:Name="PART_ContentHost"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"
                                          Padding="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>

                        </Border>


                        <ControlTemplate.Triggers>

                            <Trigger Property="IsKeyboardFocused"
                                     Value="True">

                                <Setter TargetName="TextBoxBorder"
                                        Property="BorderBrush"
                                        Value="#0067C0"/>

                            </Trigger>


                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter TargetName="TextBoxBorder"
                                        Property="Opacity"
                                        Value="0.5"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        

        <Style x:Key="ToggleSwitch"
               TargetType="ToggleButton">

            <Setter Property="Width"
                    Value="40"/>

            <Setter Property="Height"
                    Value="20"/>

            <Setter Property="Background"
                    Value="#767676"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="ToggleButton">

                        <Grid Width="40"
                              Height="20">

                            <Border x:Name="Track"
                                    Width="40"
                                    Height="20"
                                    CornerRadius="10"
                                    Background="{TemplateBinding Background}">

                                <Ellipse x:Name="Thumb"
                                         Width="16"
                                         Height="16"
                                         Fill="White"
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Center"
                                         Margin="2,0,0,0"/>

                            </Border>

                        </Grid>


                        <ControlTemplate.Triggers>

                            <Trigger Property="IsChecked"
                                     Value="True">

                                <Setter TargetName="Track"
                                        Property="Background"
                                        Value="#0067C0"/>

                                <Setter TargetName="Thumb"
                                        Property="HorizontalAlignment"
                                        Value="Right"/>

                                <Setter TargetName="Thumb"
                                        Property="Margin"
                                        Value="0,0,2,0"/>

                            </Trigger>


                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter TargetName="Track"
                                        Property="Opacity"
                                        Value="0.5"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Window.Resources>


    <Grid Margin="28">

        <StackPanel x:Name="MainPage">


        

        <Border Style="{StaticResource Card}">

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="50"/>

                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>


                <Border Grid.Row="0"
                        BorderBrush="#E5E5E5"
                        BorderThickness="0,0,0,1">

                    <TextBlock Text="Game folder"
                               Style="{StaticResource SectionTitle}"
                               Margin="18,0"/>

                </Border>


                <Grid Grid.Row="1"
                      Margin="18,20,18,20">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="Auto"/>

                    </Grid.ColumnDefinitions>


                    <TextBox x:Name="FolderPathTextBox"
                             Grid.Column="0"
                             VerticalAlignment="Center"
                             ToolTip="Type or paste a folder path, then press Enter to scan."
                             KeyDown="FolderPathTextBox_KeyDown"
                             TextChanged="FolderPathTextBox_TextChanged"/>


                    <Button Grid.Column="1"
                            Content="Browse"
                            Height="37"
                            MinWidth="88"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Click="BrowseButton_Click"/>

                </Grid>

            </Grid>

        </Border>


        

        <Border x:Name="DlssSectionCard"
                IsEnabled="False"
                Opacity="0.5"
                Style="{StaticResource Card}"
                Margin="0,16,0,0">

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="50"/>

                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>


                <Border Grid.Row="0"
                        BorderBrush="#E5E5E5"
                        BorderThickness="0,0,0,1">

                    <TextBlock Text="DLSS files"
                               Style="{StaticResource SectionTitle}"
                               Margin="18,0"/>

                </Border>


                <Grid Grid.Row="1"
                      Height="52">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="DlssStatusText"
                               Grid.Column="0"
                               Text=""
                               Foreground="#666666"
                               FontSize="14"
                               Margin="18,0"
                               VerticalAlignment="Center"/>
                    <Button x:Name="ShowDetailsButton"
                            Grid.Column="1"
                            Content="Show details"
                            Margin="0,0,18,0"
                            Visibility="Collapsed"
                            Click="ShowDetailsButton_Click"/>
                </Grid>

                <StackPanel Grid.Row="1"
                            Margin="18,4,18,4"
                            Visibility="Collapsed">


                    

                    <Grid>

                        <Grid.RowDefinitions>

                            <RowDefinition Height="50"/>

                            <RowDefinition Height="Auto"/>

                        </Grid.RowDefinitions>


                        <Grid Grid.Row="0">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="30"/>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="75"/>

                                <ColumnDefinition Width="120"/>

                                <ColumnDefinition Width="32"/>

                            </Grid.ColumnDefinitions>


                            <TextBlock x:Name="DlssIconText"
                                       Grid.Column="0"
                                       Text="!"
                                       Foreground="#666666"
                                       FontSize="16"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"/>


                            <TextBlock x:Name="DlssFileNameText"
                                       Grid.Column="1"
                                       Text="nvngx_dlss.dll"
                                       FontSize="14"
                                       VerticalAlignment="Center"/>


                            <TextBlock x:Name="LegacyDlssStatusText"
                                       Grid.Column="3"
                                       Text="Not found"
                                       FontSize="13"
                                       Foreground="#666666"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"/>


                            <Button x:Name="DlssExpandButton"
                                    Grid.Column="4"
                                    Style="{StaticResource ExpandButton}"
                                    Content="▼"
                                    Visibility="Collapsed"
                                    Click="DlssExpandButton_Click"/>

                        </Grid>


                        <ScrollViewer x:Name="DlssFileList"
                                      Grid.Row="1"
                                      Margin="30,0,7.5,8"
                                      MaxHeight="84"
                                      VerticalAlignment="Top"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Visibility="Collapsed">

                            <StackPanel x:Name="DlssFileListPanel"/>

                        </ScrollViewer>

                    </Grid>


                    <Border Height="1"
                            Background="#E5E5E5"/>


                    

                    <Grid>

                        <Grid.RowDefinitions>

                            <RowDefinition Height="50"/>

                            <RowDefinition Height="Auto"/>

                        </Grid.RowDefinitions>


                        <Grid Grid.Row="0">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="30"/>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="75"/>

                                <ColumnDefinition Width="120"/>

                                <ColumnDefinition Width="32"/>

                            </Grid.ColumnDefinitions>


                            <TextBlock x:Name="DlssdIconText"
                                       Grid.Column="0"
                                       Text="!"
                                       Foreground="#666666"
                                       FontSize="16"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"/>


                            <TextBlock x:Name="DlssdFileNameText"
                                       Grid.Column="1"
                                       Text="nvngx_dlssd.dll"
                                       FontSize="14"
                                       VerticalAlignment="Center"/>


                            <TextBlock x:Name="DlssdStatusText"
                                       Grid.Column="3"
                                       Text="Not found"
                                       FontSize="13"
                                       Foreground="#666666"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"/>


                            <Button x:Name="DlssdExpandButton"
                                    Grid.Column="4"
                                    Style="{StaticResource ExpandButton}"
                                    Content="▼"
                                    Visibility="Collapsed"
                                    Click="DlssdExpandButton_Click"/>

                        </Grid>


                        <ScrollViewer x:Name="DlssdFileList"
                                      Grid.Row="1"
                                      Margin="30,0,8,8"
                                      MaxHeight="112"
                                      VerticalAlignment="Top"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Visibility="Collapsed">

                            <StackPanel x:Name="DlssdFileListPanel"/>

                        </ScrollViewer>

                    </Grid>


                    <Border Height="1"
                            Background="#E5E5E5"/>


                    

                    <Grid>

                        <Grid.RowDefinitions>

                            <RowDefinition Height="50"/>

                            <RowDefinition Height="Auto"/>

                        </Grid.RowDefinitions>


                        <Grid Grid.Row="0">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="30"/>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="75"/>

                                <ColumnDefinition Width="120"/>

                                <ColumnDefinition Width="32"/>

                            </Grid.ColumnDefinitions>


                            <TextBlock x:Name="DlssgIconText"
                                       Grid.Column="0"
                                       Text="!"
                                       Foreground="#666666"
                                       FontSize="16"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"/>


                            <TextBlock x:Name="DlssgFileNameText"
                                       Grid.Column="1"
                                       Text="nvngx_dlssg.dll"
                                       FontSize="14"
                                       VerticalAlignment="Center"/>


                            <TextBlock x:Name="DlssgStatusText"
                                       Grid.Column="3"
                                       Text="Not found"
                                       FontSize="13"
                                       Foreground="#666666"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"/>


                            <Button x:Name="DlssgExpandButton"
                                    Grid.Column="4"
                                    Style="{StaticResource ExpandButton}"
                                    Content="▼"
                                    Visibility="Collapsed"
                                    Click="DlssgExpandButton_Click"/>

                        </Grid>


                        <ScrollViewer x:Name="DlssgFileList"
                                      Grid.Row="1"
                                      Margin="30,0,8,8"
                                      MaxHeight="112"
                                      VerticalAlignment="Top"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Visibility="Collapsed">

                            <StackPanel x:Name="DlssgFileListPanel"/>

                        </ScrollViewer>

                    </Grid>

                </StackPanel>

            </Grid>

        </Border>


        

        <Border x:Name="BackupSectionCard"
                IsEnabled="False"
                Opacity="0.5"
                Style="{StaticResource Card}"
                Margin="0,16,0,0">

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="50"/>

                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>


                <Border Grid.Row="0"
                        BorderBrush="#E5E5E5"
                        BorderThickness="0,0,0,1">

                    <TextBlock Text="Backup"
                               Style="{StaticResource SectionTitle}"
                               Margin="18,0"/>

                </Border>


                <Grid Grid.Row="1">

                    <Grid.RowDefinitions>

                        <RowDefinition Height="52"/>

                        <RowDefinition Height="1"/>

                        <RowDefinition Height="52"/>

                    </Grid.RowDefinitions>


                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="Auto"/>

                    </Grid.ColumnDefinitions>


                    <TextBlock x:Name="BackupStatusText"
                               Grid.Row="0"
                               Grid.Column="0"
                               Text=""
                               Foreground="#666666"
                               FontSize="14"
                               Margin="18,0"
                               VerticalAlignment="Center"/>


                    <StackPanel Grid.Row="0"
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Margin="0,0,18,0"
                                VerticalAlignment="Center">

                        <Button x:Name="RestoreBackupButton"
                                Content="Restore backup"
                                MinWidth="125"
                                Padding="16,0"
                                IsEnabled="False"
                                Click="RestoreBackupButton_Click"/>

                        <Button x:Name="DeleteBackupButton"
                                Content="Delete backup"
                                MinWidth="115"
                                Padding="16,0"
                                Margin="8,0,0,0"
                                IsEnabled="False"
                                Click="DeleteBackupButton_Click"/>

                    </StackPanel>


                    <Border Grid.Row="1"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Background="#E5E5E5"/>


                    <TextBlock Grid.Row="2"
                               Grid.Column="0"
                               Text="Overwrite backup when updating"
                               FontSize="14"
                               Margin="18,0"
                               VerticalAlignment="Center"/>


                    <StackPanel Grid.Row="2"
                                Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,18,0">

                        <TextBlock FontSize="13"
                                   Foreground="#666666"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0">

                            <TextBlock.Style>

                                <Style TargetType="TextBlock">

                                    <Setter Property="Text"
                                            Value="On"/>

                                    <Style.Triggers>

                                        <DataTrigger Binding="{Binding IsChecked, ElementName=OverwriteToggle}"
                                                     Value="False">

                                            <Setter Property="Text"
                                                    Value="Off"/>

                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>

                            </TextBlock.Style>

                        </TextBlock>


                        <ToggleButton x:Name="OverwriteToggle"
                                      Style="{StaticResource ToggleSwitch}"
                                      IsChecked="True"
                                      IsEnabled="False"/>

                    </StackPanel>

                </Grid>

            </Grid>

        </Border>


        

        <Button x:Name="UpdateButton"
                Content="Update"
                Style="{StaticResource PrimaryButton}"
                IsEnabled="False"
                Opacity="0.5"
                HorizontalAlignment="Right"
                Margin="0,20,0,0"
                Click="UpdateButton_Click"/>


        </StackPanel>

        <Grid x:Name="DlssDetailsPage"
              Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Content="← Back"
                        MinWidth="90"
                        Margin="0,0,16,0"
                        Click="BackFromDetailsButton_Click"/>
                <TextBlock Grid.Column="1"
                           Text="DLSS file details"
                           Style="{StaticResource SectionTitle}"
                           VerticalAlignment="Center"/>
            </Grid>

            <StackPanel Grid.Row="1"
                        Margin="0,12,0,0">
                <TextBlock x:Name="DetailsSummaryText"
                           Foreground="#666666"
                           Margin="0,0,0,12"/>
                <Border Style="{StaticResource Card}"
                        Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Type" FontWeight="SemiBold" Foreground="#666666"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Version" FontWeight="SemiBold" Foreground="#666666"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Location" FontWeight="SemiBold" Foreground="#666666"/>
                        <ScrollViewer Grid.Row="1"
                                      Grid.ColumnSpan="3"
                                      MaxHeight="430"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="DetailsFileListPanel"/>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>

    </Grid>

</Window>
